# ===== required: it won't start without these =====

# the login password for Heat
APP_PASSWORD=
# 32+ random characters: signs the login cookie and seals the Claude API key
#   openssl rand -hex 32
HEAT_SECRET=
# one login for all the Bastion apps on this server (Bastion HA, Cams, Heat, Watch):
# the same value in every app's .env, and the same APP_PASSWORD in Cams, Heat and
# Watch; signing in to one signs in to all.   openssl rand -hex 32
BASTION_SESSION_SECRET=
# Home Assistant: Heat reads every heating entity and sends the commands
HASS_URL=http://192.168.10.117:8123
# Profile > Security > Long-lived access tokens
HASS_TOKEN=

# ===== recommended =====

# where phones reach this app; links in notifications, and Bastion HA's button
APP_URL=http://192.168.10.12:5090

# ===== optional =====

# the assistant on the Claude subscription, through bastion-ai (same server):
# its address and its GATEWAY_TOKEN. bastion-ai reaches Heat's tools at APP_URL/mcp
# (or BASTION_AI_MCP_URL when that differs)
BASTION_AI_URL=http://192.168.10.12:5095
BASTION_AI_TOKEN=
# BASTION_AI_MCP_URL=http://192.168.10.12:5090/mcp
# or, without bastion-ai, a Claude API key (paid per token); also in Postavke → Asistent
ANTHROPIC_API_KEY=
TZ=Europe/Zagreb
EXPOSED_PORT=5090
BASTION_HEAT_TAG=
